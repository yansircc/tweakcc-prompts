{
  "name": "tweakcc-prompts",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "apply": "npx tweakcc --apply",
    "restore": "bun run scripts/restore.ts",
    "validate": "npx tweakcc --apply && ccc --model claude-haiku-4-5-20251001 -p \"Reply me 'I'm fine' for testing purpose\"",
    "check": "bun run scripts/check.ts",
    "check:json": "bun run scripts/check.ts --json"
  },
  "devDependencies": {
    "bun-types": "^1.2.17",
    "husky": "^9.1.7"
  }
}